{
  "name": "function-hills",
  "productName": "函数丘陵",
  "version": "1.1.2",
  "description": "三维函数世界 —— 进入由数学函数生成的世界自由探索",
  "author": "函数丘陵",
  "main": "electron/main.js",
  "scripts": {
    "build": "esbuild src/workers/implicitWorker.js --bundle --outfile=src/dist/implicit.worker.txt --format=iife --platform=browser && esbuild src/main.js --bundle --outfile=src/dist/bundle.js --format=esm --platform=browser",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win portable"
  },
  "dependencies": {},
  "devDependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.0",
    "isosurface": "^1.0.0",
    "mathjs": "^13.0.0",
    "three": "^0.170.0"
  },
  "build": {
    "appId": "com.functionhills.app",
    "productName": "函数丘陵",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.png",
      "artifactName": "函数丘陵.exe"
    }
  }
}
